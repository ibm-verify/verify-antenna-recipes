{
  "type": "object",
  "required": [
    "data"
  ],
  "properties": {
    "data": {
      "type": "object",
      "required": [
        "schemas",
        "displayName"
      ],
      "properties": {
        "schemas": {
          "type": "array",
          "const": [
            "urn:ietf:params:scim:schemas:core:ibm:2.0:Agent"
          ]
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "externalIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "owners": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "minLength": 1
              },
              "$ref": {
                "type": "string"
              },
              "display": {
                "type": "string"
              }
            },
            "required": [
              "value",
              "type"
            ]
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "version": {
          "type": "string"
        }
      }
    },
    "reason_admin": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z]{1,8}(-[a-zA-Z0-9]{1,8})*$": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "event_timestamp": {
      "type": "integer"
    }
  }
}